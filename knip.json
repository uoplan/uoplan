{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["apps/cli/target/**"],
  "workspaces": {
    "apps/web": {
      "vite": false,
      "entry": [
        "src/main.tsx",
        "src/workers/sw.ts",
        "scripts/**/*.mjs",
        "vite.config.ts",
        "lingui.config.ts",
        "vite/**"
      ]
    },
    "apps/worker": {
      "entry": ["scripts/og-image.ts"],
      "ignoreDependencies": ["@marsidev/react-turnstile", "wrangler"]
    },
    "apps/scrapers": {
      "entry": ["src/**/*.ts"]
    },
    "packages/core": {
      "entry": ["src/**/*.ts"],
      "ignoreDependencies": ["ts-proto"]
    },
    "apps/cli": {}
  }
}
