{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["apps/cli/target/**"],
  "workspaces": {
    "apps/web": {
      "vite": false,
      "entry": [
        "src/main.tsx",
        "src/workers/sw.ts",
        "src/test/browserSetup.ts",
        "src/test/engineSetup.ts",
        "scripts/**/*.mjs",
        "vite.config.ts",
        "lingui.config.ts",
        "vite/**"
      ],
      "ignoreDependencies": ["@vitest/browser"]
    },
    "apps/worker": {
      "entry": ["scripts/og-image.ts"],
      "ignoreDependencies": ["@marsidev/react-turnstile", "wrangler"]
    },
    "apps/scraper": {
      "entry": ["src/cli/verifyCatalogue.ts", "src/cli/verifyScheduleDates.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/core": {},
    "packages/engine": {
      "ignoreBinaries": ["wasm-pack"]
    },
    "packages/proto": {
      "ignoreDependencies": ["@bufbuild/protobuf", "ts-proto"]
    },
    "apps/cli": {}
  }
}
