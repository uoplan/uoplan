{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  // Migrated from knip.json, then audited against fallow's analysis.
  // Fallow auto-discovers pnpm workspaces from pnpm-workspace.yaml and most
  // entry points from package.json + framework plugins; only genuine roots
  // that fallow does not auto-detect are listed here. apps/cli is a pure Rust
  // crate (no JS/TS) so it is excluded entirely.
  // The __fixtures__/*.html files are saved HTML pages used as scraper test
  // fixtures (read from disk, never imported); fallow would otherwise report
  // their inert <script>/<link> asset URLs as unresolved imports.
  // routeTree.gen.ts is auto-generated by TanStack Router; its repetitive
  // generated structure is not meaningful duplication.
  // apps/native is an Expo / React Native app: fallow does not model React
  // Native's platform-extension resolution (e.g. `./x` resolving to `x.web.tsx`
  // on web vs `x.tsx`/`x.native.tsx` on device — so the "other" variant always
  // looks unreachable) nor config-plugin/runtime-only deps (expo-splash-screen
  // is wired via app.json plugins, react-native-web is the Metro web target,
  // react-native-gesture-handler is auto-linked, etc.), so it is excluded here.
  // packages/ui is the cross-platform component contract: each primitive ships
  // a `*.web.tsx` (Mantine) and `*.native.tsx` (React Native) variant resolved
  // by the bundler (Vite picks `.web`, Metro picks `.native`). fallow analyses
  // the web entry graph, so the `.native` variants always look unreachable —
  // exclude only those (the `.web.tsx` + shared `.types.ts` stay gated).
  // `nativeTheme.ts` is the shared native-only palette imported solely by those
  // `.native.tsx` variants; it is a plain `.ts` (not `.native.ts`, which would
  // break ui's own `moduleSuffixes: [".web", ""]` typecheck) so it falls outside
  // the `*.native.ts` glob and is listed explicitly.
  // apps/marketing is an isolated Remotion launch-video project (excluded from the
  // pnpm workspace; its own node_modules + lockfile, different toolchain). It is not
  // part of the app/site import graph, so exclude it from dead-code/duplication checks.
  "ignorePatterns": [
    "apps/cli/**",
    "apps/native/**",
    "apps/marketing/**",
    "packages/ui/src/**/*.native.tsx",
    "packages/ui/src/**/*.native.ts",
    "packages/ui/src/nativeTheme.ts",
    "**/__fixtures__/**/*.html",
    "**/routeTree.gen.ts"
  ],
  "entry": [
    "apps/web/src/main.tsx",
    "apps/web/src/workers/sw.ts",
    "apps/web/src/test/browserSetup.ts",
    "apps/web/src/test/engineSetup.ts",
    "apps/web/scripts/**/*.ts",
    "apps/web/vite.config.ts",
    "apps/web/vite/**",
    "oxfmt.config.ts",
    "packages/i18n/lingui.config.ts",
    "packages/theme/scripts/generate-native-tokens.ts",
    "scripts/route-js-sizes.test.ts"
  ],
  // Deps genuinely used but invisible to fallow's resolver:
  // - @bufbuild/protobuf is imported by git-ignored generated proto code.
  // - ts-proto is a protoc codegen plugin invoked by the generate:proto script.
  // - @uoplan/proto: the apps import only subpaths (@uoplan/proto/cli|data|
  //   feedback|state); fallow credits the bare-specifier usage to packages/core,
  //   so each app's own dependency looks unused.
  // - @uoplan/engine: bare-imported in apps/web (engineHost.ts), but its "."
  //   export resolves to the git-ignored wasm-pack build artifact (pkg/), so
  //   fallow can't see a resolvable import.
  // - @size-limit/file: required at runtime by size-limit (the file checker for
  //   .size-limit.json) but never imported from TS source.
  // - expo-symbols: imported only by packages/ui's `Icon.native.tsx` (the SF
  //   Symbols Icon variant), which is in ignorePatterns above, so fallow's web
  //   entry graph never sees the import. @tabler/icons-react + framer-motion are
  //   used by the `.web.tsx` variants so they stay gated normally.
  // - @uoplan/theme: in packages/ui only to back `nativeTheme.ts` (the shared
  //   native palette), which is in ignorePatterns above, so fallow's web entry
  //   graph never sees ui import it. (apps/web still uses @uoplan/theme directly.)
  // - @lhci/cli: invoked as a CLI binary (`pnpm exec lhci`) by scripts/
  //   lighthouse.ts (the `pnpm lighthouse` / pre-push audit), never imported.
  // (knip's @vitest/browser + wrangler ignores were redundant under fallow, and
  // its @marsidev/react-turnstile ignore masked a real unused dep in the
  // worker — all three were dropped.)
  "ignoreDependencies": [
    "@bufbuild/protobuf",
    "ts-proto",
    "@uoplan/proto",
    "@uoplan/engine",
    "@size-limit/file",
    "expo-symbols",
    "@uoplan/theme",
    "@lhci/cli"
  ],
  // The only clone shared by these two seed-navigation test files is the
  // hoisted `vi.mock("../../workers/scheduleWorkerClient", ...)` setup block
  // (plus its imports). `vi.mock` is file-scoped and hoisted by Vitest, so it
  // cannot be extracted into a shared module — importing it would not apply the
  // mock. Everything else extractable (resetStoreForSeedTests,
  // emptyScheduleGenerationResult) already lives in scheduleTestHelpers.ts.
  //
  // The remaining ignored files are small, independent test fixtures/setup
  // blocks that are intentionally local (for readability + test isolation) or
  // span package boundaries, where a shared test-only helper would have to be
  // exposed through a package's public surface just to dedupe a fixture:
  //  - transcriptParser.test ↔ packages/core parseHelpers.test: a `textPage`
  //    fixture plus a `detectFrenchImmersionStreamHint` describe block. That
  //    helper is a core function re-exported by @uoplan/transcript, so it is
  //    legitimately covered on both sides (core unit + transcript re-export).
  //  - welcomeScreenContract ↔ BasketContents browser tests: TanStack Router
  //    stub-route setup. The two routers differ (root component, paths, stub
  //    labels) and a shared factory would fight TanStack's route generics.
  //  - requirementUtils.test ↔ packages/core ics.test: a partial `DataCache`
  //    no-op stub tail; each builds its own minimal stub.
  //  - appStoreProvider.browser.test: two distinct test cases that both assert
  //    the default (un-seeded) store value; kept inline for test independence.
  //  - BasicCalendarSidebarControls.browser.test ↔ AdvancedGenerationOptions
  //    browser test: the hoisted `vi.mock("@tanstack/react-router")` Link stub
  //    (+ its MockLinkProps). `vi.mock` is file-scoped and hoisted by Vitest, so
  //    importing a shared module would not apply the mock — it cannot be
  //    extracted. Ignore the sidebar test (its only clone is this stub); the
  //    AdvancedGenerationOptions side stays analysed so its own dupes still gate.
  //  - route-js-sizes.ts ↔ data-asset-sizes.ts: the small `--json`/`--save`
  //    snapshot-CLI arg-parsing tail. The two scripts operate on different data
  //    shapes (SizeReport vs AssetSize[]) with different print + snapshot-path
  //    logic, so the shared surface is just this inert CLI boilerplate; a generic
  //    helper would add more indirection than the 8 lines it removes.
  "duplicates": {
    "ignore": [
      "apps/web/src/store/tests/generationOptionsDirty.test.ts",
      "apps/web/src/store/tests/schedules.seedNavigation.test.ts",
      "packages/transcript/src/transcriptParser.test.ts",
      "apps/web/src/test/welcomeScreenContract.browser.test.tsx",
      "apps/web/src/lib/requirements/requirementUtils.test.ts",
      "apps/web/src/test/appStoreProvider.browser.test.tsx",
      "apps/web/src/components/calendar/BasicCalendarSidebarControls.browser.test.tsx",
      "scripts/route-js-sizes.ts"
    ]
  }
}
