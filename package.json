{
  "name": "uoplan-monorepo",
  "version": "1.0.0-beta.29",
  "private": true,
  "scripts": {
    "dev": "pnpm generate && pnpm build:engine-wasm && pnpm --filter scraper build:proto && pnpm --filter web dev",
    "build": "pnpm generate && pnpm build:engine-wasm && pnpm --filter scraper build:proto && pnpm --filter web build",
    "deploy": "wrangler deploy",
    "generate": "pnpm -r generate && pnpm build:data-proto",
    "typecheck": "pnpm wrangler types && pnpm -r typecheck",
    "lint": "oxlint apps/web/src apps/scraper/src packages/core/src",
    "lint:fix": "oxlint --fix apps/web/src apps/scraper/src packages/core/src",
    "check:arch": "node scripts/check-architecture.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "i18n:sync": "node scripts/i18n-sync.mjs",
    "sync:proto-cli": "cp packages/proto/proto/cli.proto apps/cli/proto/cli.proto",
    "build:engine-wasm": "bash scripts/build-engine-wasm.sh",
    "build:engine-wasm:dev": "bash scripts/build-engine-wasm.sh --dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "pnpm run -r test",
    "bench": "pnpm --filter @uoplan/core bench",
    "test:watch": "pnpm --filter web test:watch",
    "og-image": "pnpm --filter worker og-image",
    "prepare": "lefthook install",
    "hooks:install": "lefthook install",
    "hooks:run": "lefthook run pre-commit",
    "deadcode": "knip",
    "scrape:catalogue": "pnpm --filter scraper scrape:catalogue",
    "scrape:schedules": "pnpm --filter scraper scrape:schedules",
    "scrape:disciplines": "pnpm --filter scraper scrape:disciplines",
    "enrich:schedules": "pnpm --filter scraper enrich:schedules",
    "scrape:ratemyprofessors": "pnpm --filter scraper scrape:ratemyprofessors",
    "build:data-proto": "pnpm --filter scraper build:proto",
    "check:terms": "pnpm --filter scraper check:terms",
    "cli": "pnpm --silent --filter @uoplan/cli dev --"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260512.1",
    "esbuild": "^0.28.0",
    "knip": "^6.1.0",
    "lefthook": "^2.1.4",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.64.0",
    "oxlint-tsgolint": "^0.22.1",
    "pofile": "^1.1.4",
    "typescript": "^5.9.3",
    "wrangler": "^4.84.1"
  },
  "packageManager": "pnpm@10.27.0"
}
