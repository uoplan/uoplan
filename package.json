{
  "name": "uoplan-monorepo",
  "version": "1.0.0-beta.17",
  "private": true,
  "scripts": {
    "dev": "pnpm generate && pnpm --filter scrapers build:proto && pnpm --filter web dev",
    "build": "pnpm generate && pnpm --filter scrapers build:proto && pnpm --filter web build",
    "deploy": "wrangler deploy",
    "generate": "pnpm -r generate && pnpm build:data-proto",
    "typecheck": "pnpm wrangler types && pnpm -r typecheck",
    "lint": "oxlint apps/web/src apps/scrapers/src packages/schedule/src",
    "lint:fix": "oxlint --fix apps/web/src apps/scrapers/src packages/schedule/src",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "pnpm run -r test",
    "bench": "pnpm --filter schedule bench",
    "test:watch": "pnpm --filter web test:watch",
    "prepare": "lefthook install",
    "hooks:install": "lefthook install",
    "hooks:run": "lefthook run pre-commit",
    "deadcode": "knip",
    "scrape:catalogue": "pnpm --filter scrapers scrape:catalogue",
    "scrape:schedules": "pnpm --filter scrapers scrape:schedules",
    "scrape:disciplines": "pnpm --filter scrapers scrape:disciplines",
    "enrich:schedules": "pnpm --filter scrapers enrich:schedules",
    "scrape:ratemyprofessors": "pnpm --filter scrapers scrape:ratemyprofessors",
    "build:data-proto": "pnpm --filter scrapers build:proto",
    "check:terms": "pnpm --filter scrapers check:terms",
    "cli": "pnpm --silent --filter @uoplan/cli dev --"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260512.1",
    "knip": "^6.1.0",
    "lefthook": "^2.1.4",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.64.0",
    "oxlint-tsgolint": "^0.22.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.84.1"
  },
  "packageManager": "pnpm@10.27.0"
}
