{
  "name": "uoplan-monorepo",
  "version": "1.0.0-beta.35",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm generate && pnpm build:engine-wasm && pnpm --filter web dev",
    "build": "pnpm generate && pnpm build:engine-wasm && pnpm --filter web build",
    "deploy": "pnpm build && wrangler deploy -c apps/web/dist/uoplan/wrangler.json",
    "generate": "pnpm -r generate && pnpm build:data-proto",
    "typecheck": "pnpm wrangler types && pnpm -r typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check:arch": "node scripts/check-architecture.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "i18n:sync": "node scripts/i18n-sync.mjs",
    "sync:proto-cli": "cp packages/proto/proto/cli.proto apps/cli/proto/cli.proto",
    "build:cf": "bash scripts/cf-build.sh",
    "build:engine-wasm": "bash scripts/build-engine-wasm.sh",
    "build:engine-wasm:dev": "bash scripts/build-engine-wasm.sh --dev",
    "build:engine-native-ffi": "node scripts/build-native-engine-ffi.mjs",
    "build:engine-native-ffi-android": "node scripts/build-native-engine-ffi-android.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "pnpm run -r test",
    "test:coverage": "pnpm run -r test:coverage",
    "test:ui": "pnpm --filter web test:ui",
    "coverage:rust": "pnpm --filter @uoplan/engine coverage",
    "bench": "pnpm --filter @uoplan/core bench",
    "test:watch": "pnpm --filter web test:watch",
    "lighthouse": "node scripts/lighthouse.mjs",
    "prepare": "lefthook install",
    "hooks:run": "lefthook run pre-commit",
    "fallow": "fallow",
    "check:fallow": "fallow --fail-on-issues --skip health",
    "size": "pnpm --filter web size",
    "analyze": "pnpm --filter web analyze",
    "data:grades": "pnpm --filter scraper grades:convert && pnpm --filter scraper scrape:grades && pnpm --filter scraper enrich:schedules && pnpm build:data-proto",
    "data:build": "pnpm --filter scraper grades:convert && pnpm --filter scraper scrape:grades && pnpm --filter scraper build:professors && pnpm --filter scraper enrich:schedules && pnpm build:data-proto",
    "build:data-proto": "pnpm --filter scraper build:proto",
    "cli": "cargo run --quiet --manifest-path apps/cli/Cargo.toml --"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@typescript/native-preview": "7.0.0-dev.20260512.1",
    "esbuild": "^0.28.0",
    "fallow": "^2.88.2",
    "lefthook": "^2.1.4",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.64.0",
    "oxlint-tsgolint": "^0.22.1",
    "pofile": "^1.1.4",
    "typescript": "^5.9.3",
    "wrangler": "^4.96.0"
  },
  "packageManager": "pnpm@10.27.0"
}
