{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["chrome", "webextension-polyfill", "node"],
    "jsx": "preserve",
    "noEmit": true,
