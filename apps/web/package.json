{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-og-image.ts && vite build && node scripts/prerender-seo-html.ts && node scripts/generate-sitemap.ts",
    "analyze": "ANALYZE=1 vite build",
    "size": "size-limit",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.node.json && tsgo --noEmit -p tsconfig.sw.json",
    "preview": "vite preview",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --coverage",
    "test:coverage:unit": "vitest run --project unit --coverage",
    "test:ui": "vitest --project unit --ui --coverage",
    "test:browser": "vitest run --project browser",
    "test:e2e": "playwright test",
    "coverage:crawl": "playwright test --config playwright.coverage.config.ts",
    "coverage:dev": "COVERAGE=1 VITE_COVERAGE=true vite --port 5274 --strictPort",
    "coverage:report": "node scripts/runtime-coverage/report.ts",
    "coverage:clean": "node scripts/runtime-coverage/report.ts --clean"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/dm-mono": "^5.2.7",
    "@fontsource/dm-serif-display": "^5.2.8",
    "@lingui/core": "^5.9.3",
    "@lingui/detect-locale": "^5.9.3",
    "@lingui/react": "^5.9.3",
    "@mantine/charts": "^9.2.1",
    "@mantine/core": "^9.2.0",
    "@mantine/hooks": "^9.2.0",
    "@mantine/notifications": "^9.2.1",
    "@mantine/nprogress": "^9.2.1",
    "@mantine/spotlight": "^9.2.1",
    "@marsidev/react-turnstile": "^1.5.0",
    "@tabler/icons-react": "^3.40.0",
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/react-virtual": "^3.13.26",
    "@uoplan/analytics": "workspace:^",
    "@uoplan/app": "workspace:^",
    "@uoplan/calendar": "workspace:^",
    "@uoplan/core": "workspace:^",
    "@uoplan/data": "workspace:^",
    "@uoplan/engine": "workspace:^",
    "@uoplan/i18n": "workspace:^",
    "@uoplan/navigation": "workspace:^",
    "@uoplan/proto": "workspace:^",
    "@uoplan/search": "workspace:*",
    "@uoplan/store": "workspace:^",
    "@uoplan/theme": "workspace:^",
    "@uoplan/transcript": "workspace:^",
    "@uoplan/ui": "workspace:^",
    "@xyflow/react": "12.11.1",
    "comlink": "^4.4.2",
    "framer-motion": "^12.36.0",
    "fuse.js": "^7.3.0",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "posthog-js": "^1.386.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.1",
    "sigma": "^3.0.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@cloudflare/vite-plugin": "^1.39.1",
    "@napi-rs/canvas": "^0.1.99",
    "@playwright/test": "^1.60.0",
    "@size-limit/file": "^12.1.0",
    "@tanstack/router-plugin": "^1.167.35",
    "@types/istanbul-lib-coverage": "2.0.6",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser": "^4.1.7",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/coverage-v8": "4.1.7",
    "@vitest/ui": "4.1.7",
    "istanbul-lib-coverage": "3.2.2",
    "markdown-it": "^14.1.1",
    "nyc": "18.0.0",
    "playwright": "^1.60.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "size-limit": "^12.1.0",
    "vite": "^8.0.0",
    "vite-plugin-istanbul": "9.0.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.7",
    "vitest-browser-react": "^2.2.0",
    "wrangler": "^4.96.0"
  }
}
