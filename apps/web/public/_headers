# Custom headers for Cloudflare Workers Static Assets.
# https://developers.cloudflare.com/workers/static-assets/headers/
#
# Cloudflare's default for every asset is `Cache-Control: public, max-age=0,
# must-revalidate` (+ ETag), which makes the browser revalidate every file on
# every visit. For Vite's content-hashed build output under /assets/* the URL
# changes whenever the bytes change, so those files are safe to cache forever —
# this eliminates a per-asset revalidation round-trip on repeat visits.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# NOTE: the per-school protobuf datasets are imported through Vite, so they are
# content-hashed into /assets/* and pick up the immutable cache above. The lookup
# table that maps a logical, school-namespaced asset id
# (e.g. "carleton/catalogue.union.pb") to its hashed URL is /data/manifest.json —
# a stable filename whose contents change on every redeploy. It is deliberately
# NOT under /assets/*, so it keeps Cloudflare's default revalidating cache. Do not
# add an immutable rule for /data/* : a stale manifest would point every client at
# the previous deploy's asset URLs.
#
# /fonts/* likewise use stable (non-hashed) filenames whose content can change on
# redeploy, so they also keep the default revalidating cache
# (ETag/If-None-Match → 304, no re-download when unchanged).
