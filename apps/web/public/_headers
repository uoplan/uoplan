# Custom headers for Cloudflare Workers Static Assets.
# https://developers.cloudflare.com/workers/static-assets/headers/
#
# Cloudflare's default for every asset is `Cache-Control: public, max-age=0,
# must-revalidate` (+ ETag), which makes the browser revalidate every file on
# every visit. For Vite's content-hashed build output under /assets/* the URL
# changes whenever the bytes change, so those files are safe to cache forever —
# this eliminates a per-asset revalidation round-trip on repeat visits.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# NOTE: /data/*.pb and /fonts/* use stable (non-hashed) filenames whose content
# can change on redeploy, so they intentionally keep Cloudflare's default
# revalidating cache (ETag/If-None-Match → 304, no re-download when unchanged).
