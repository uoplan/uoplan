# PostHog analytics (all optional — defaults are committed in @uoplan/analytics).
# The project key is a PUBLISHABLE key (safe in the client bundle), not a secret.
# VITE_POSTHOG_KEY=phc_xxx
# Ingest host — the t.uoplan.party managed reverse proxy.
# VITE_POSTHOG_HOST=https://t.uoplan.party
# PostHog UI host for the EU region.
# VITE_POSTHOG_UI_HOST=https://eu.posthog.com
# Set to 1 to enable analytics capture in local dev (off by default outside production).
# VITE_POSTHOG_DEBUG=0
