{
  "expo": {
    "name": "uoplan",
    "slug": "uoplan",
    "extra": {
      "eas": {
        "projectId": "9324474b-4ac4-4f5d-871d-5eebea45fbb6"
      }
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "uoplan",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "party.uoplan.app",
      "supportsTablet": true,
      "associatedDomains": ["applinks:uoplan.party", "applinks:www.uoplan.party"],
      "infoPlist": {
        "CFBundleDisplayName": "uoPlan",
        "CFBundleName": "uoPlan",
        "ITSAppUsesNonExemptEncryption": false,
        "UIRequiresFullScreen": true,
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "package": "party.uoplan.app",
      "adaptiveIcon": {
        "backgroundColor": "#1b1a20",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "uoplan.party"
            },
            {
              "scheme": "https",
              "host": "www.uoplan.party"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": ["android.permission.READ_CALENDAR", "android.permission.WRITE_CALENDAR"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-calendar",
        {
          "calendarPermission": "uoplan needs calendar access to add your generated class schedule.",
          "remindersPermission": false,
          "writeOnlyAccess": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f7f5f2",
          "image": "./assets/images/splash-transparent.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#1b1a20"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# Rust schedule engine JNI bridge: its native methods are resolved by C\n# symbol name (Java_party_uoplan_engine_UoplanEngineModule_*), so the class\n# and method names must never be renamed or stripped by R8 or linking fails\n# at runtime with UnsatisfiedLinkError.\n-keep class party.uoplan.engine.** { *; }\n\n# Generic JNI safety net: keep the names of any class declaring native methods.\n-keepclasseswithmembernames,includedescriptorclasses class * {\n    native <methods>;\n}\n"
          }
        }
      ]
    ],
    "updates": {
      "assetPatternsToBeBundled": ["assets/**/*"]
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "uoplan"
  }
}
