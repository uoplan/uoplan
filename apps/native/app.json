{
  "expo": {
    "name": "uoPlan",
    "slug": "native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "uoplan",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "party.uoplan.native",
      "supportsTablet": true,
      "associatedDomains": ["applinks:uoplan.party", "applinks:www.uoplan.party"],
      "infoPlist": {
        "UIRequiresFullScreen": true,
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "package": "party.uoplan.app",
      "adaptiveIcon": {
        "backgroundColor": "#1b1a20",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "uoplan.party" },
            { "scheme": "https", "host": "www.uoplan.party" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-calendar",
        {
          "calendarPermission": "uoplan needs calendar access to add your generated class schedule.",
          "remindersPermission": false,
          "writeOnlyAccess": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f7f5f2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#1b1a20"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
