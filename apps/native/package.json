{
  "name": "native",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "prebuild:data": "node ./scripts/copy-bundled-data.mts",
    "prestart": "pnpm prebuild:data",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "preandroid": "pnpm prebuild:data",
    "android": "expo run:android",
    "preios": "pnpm prebuild:data",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "postinstall": "node ./scripts/eas-postinstall.mts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "expo lint",
    "gen:changelog": "node ./scripts/generate-changelog.mts",
    "gen:icons": "node ./scripts/gen-icon-paths.mts",
    "test": "jest",
    "test:export": "expo export --platform ios --output-dir /tmp/native-export-smoke && rm -rf /tmp/native-export-smoke",
    "screenshot": "./scripts/screenshot.sh"
  },
  "dependencies": {
    "@expo/ui": "~56.0.17",
    "@lingui/core": "^5.9.3",
    "@lingui/react": "^5.9.3",
    "@uoplan/analytics": "workspace:*",
    "@uoplan/app": "workspace:*",
    "@uoplan/calendar": "workspace:*",
    "@uoplan/core": "workspace:*",
    "@uoplan/data": "workspace:*",
    "@uoplan/i18n": "workspace:*",
    "@uoplan/navigation": "workspace:*",
    "@uoplan/proto": "workspace:*",
    "@uoplan/theme": "workspace:*",
    "@uoplan/ui": "workspace:*",
    "expo": "~56.0.11",
    "expo-build-properties": "~56.0.19",
    "expo-calendar": "~56.0.8",
    "expo-constants": "~56.0.18",
    "expo-device": "~56.0.4",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.6",
    "expo-glass-effect": "~56.0.4",
    "expo-image": "~56.0.11",
    "expo-linking": "~56.0.14",
    "expo-localization": "~56.0.6",
    "expo-notifications": "~56.0.17",
    "expo-router": "~56.2.10",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "posthog-react-native": "^4.47.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~56.0.15",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.5",
    "typescript": "~6.0.3"
  }
}
