{
  "name": "@uoplan/cli",
  "version": "0.1.0",
  "bin": {
    "uoplan": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "node --experimental-transform-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "publish:npm": "pnpm build && npm publish --access public",
    "typecheck": "tsgo --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "chalk": "^5",
    "cheerio": "^1",
    "chrome-remote-interface": "^0.33",
    "commander": "^12",
    "got": "^14",
    "ora": "^8",
    "schedule": "workspace:*",
    "tough-cookie": "^6",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/chrome-remote-interface": "^0.31",
    "@types/node": "^25.5.0"
  }
}
