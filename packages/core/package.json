{
  "name": "@uoplan/core",
  "version": "1.0.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./src/generation/types": "./src/generation/types.ts",
    "./professorIdentity": "./src/professorIdentity.ts",
    "./gradeLookup": "./src/gradeLookup.ts",
    "./utils/courseUtils": "./src/utils/courseUtils.ts",
    "./dataTypes/indices": "./src/dataTypes/indices.ts",
    "./dataTypes/protoDates": "./src/dataTypes/protoDates.ts",
    "./dataTypes/codeRef": "./src/dataTypes/codeRef.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./src/generation/types": "./dist/generation/types.js",
      "./professorIdentity": "./dist/professorIdentity.js",
      "./gradeLookup": "./dist/gradeLookup.js",
      "./utils/courseUtils": "./dist/utils/courseUtils.js",
      "./dataTypes/indices": "./dist/dataTypes/indices.js",
      "./dataTypes/protoDates": "./dist/dataTypes/protoDates.js",
      "./dataTypes/codeRef": "./dist/dataTypes/codeRef.js"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "publish:npm": "pnpm build && pnpm publish --access public --no-git-checks",
    "typecheck": "tsgo -b tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui --coverage",
    "bench": "vitest bench"
  },
  "dependencies": {
    "@uoplan/proto": "workspace:*",
    "fflate": "^0.8.3",
    "ical-generator": "^10.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "4.1.7",
    "@vitest/ui": "4.1.7",
    "vitest": "^4.1.0"
  }
}
