{
  "name": "@uoplan/core",
  "version": "1.0.0",
  "files": [
    "dist"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./src/generation/types": "./src/generation/types.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./src/generation/types": "./dist/generation/types.js"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "publish:npm": "pnpm build && pnpm publish --access public --no-git-checks",
    "typecheck": "tsgo -b tsconfig.json",
    "test": "vitest run",
    "bench": "vitest bench"
  },
  "dependencies": {
    "@uoplan/proto": "workspace:*",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "vitest": "^4.1.0"
  }
}
