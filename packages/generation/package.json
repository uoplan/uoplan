  "dependencies": {
    "@uoplan/domain": "workspace:*",
    "@uoplan/grades": "workspace:*",
    "@uoplan/professors": "workspace:*",
    "@uoplan/proto": "workspace:*",
    "@uoplan/requirements": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.7",
    "vitest": "4.1.7"
  }
