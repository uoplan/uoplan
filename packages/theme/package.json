{
  "name": "@uoplan/theme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsgo -b tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "generate:tokens": "node scripts/generate-native-tokens.ts",
    "check:tokens": "node scripts/generate-native-tokens.ts --check"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.7",
    "vitest": "4.1.7"
  }
}
