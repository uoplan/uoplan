{
  "name": "@uoplan/proto",
  "version": "1.0.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./data": "./src/generated/data.ts",
    "./state": "./src/generated/state.ts",
    "./cli": "./src/generated/cli.ts",
    "./engine": "./src/generated/engine.ts",
    "./feedback": "./src/generated/feedback.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./data": "./dist/generated/data.js",
      "./state": "./dist/generated/state.js",
      "./cli": "./dist/generated/cli.js",
      "./engine": "./dist/generated/engine.js",
      "./feedback": "./dist/generated/feedback.js"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "generate:proto": "mkdir -p ./src/generated && protoc --ts_proto_out=./src/generated --proto_path=./proto ./proto/state.proto ./proto/data.proto ./proto/cli.proto ./proto/engine.proto ./proto/feedback.proto --ts_proto_opt=esModuleInterop=true,forceLong=long,useOptionals=messages,outputJsonMethods=false,outputPartialMethods=false",
    "generate": "pnpm generate:proto",
    "build": "tsc -p tsconfig.json",
    "publish:npm": "pnpm build && pnpm publish --access public --no-git-checks",
    "typecheck": "tsgo -b tsconfig.json"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "protoc": "^34.0.0",
    "ts-proto": "^2.11.6"
  }
}
