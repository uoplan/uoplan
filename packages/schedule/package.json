{
  "name": "@uoplan/schedule",
  "version": "1.0.0",
  "files": [
    "dist"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./src/proto/cli": "./src/proto/cli.ts",
    "./src/generation/types": "./src/generation/types.ts",
    "./proto/cli": "./src/proto/cli.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./src/proto/cli": "./dist/proto/cli.js",
      "./src/generation/types": "./dist/generation/types.js",
      "./proto/cli": "./dist/proto/cli.js"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "generate:proto": "protoc --ts_proto_out=./src/proto --proto_path=./proto ./proto/state.proto ./proto/data.proto ./proto/cli.proto --ts_proto_opt=esModuleInterop=true,forceLong=long,useOptionals=messages,outputJsonMethods=false,outputPartialMethods=false",
    "generate": "pnpm generate:proto",
    "build": "tsc -p tsconfig.json",
    "publish:npm": "pnpm build && pnpm publish --access public --no-git-checks",
    "typecheck": "tsgo -b tsconfig.json",
    "test": "vitest run",
    "bench": "vitest bench"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "pdfjs-dist": "^5.5.207"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "protoc": "^34.0.0",
    "ts-proto": "^2.11.6",
    "vitest": "^4.1.0"
  }
}
